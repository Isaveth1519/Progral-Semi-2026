@model IEnumerable<ProyectoFinalSistemaDeRegistroMaferrerWeb.Models.Incidente>

@{
    ViewData["Title"] = "Listado";
}

<h1>Listado</h1>

<p>
    <a asp-action="Create">Nuevo registro</a>
</p>
<form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-3 p-3 mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                <input type="text" id="filtroInteractivo" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Escribe para filtrar al instante o presiona Buscar en la base de datos..." />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill me-1"></i>Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
        <div class="col text-md-end text-muted small">
            Mostrando <strong id="contadorFilas">@Model.Count()</strong> registro(s)
        </div>
    </div>
</form>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("filtroInteractivo");
        const tabla = document.querySelector("table tbody");
        const contador = document.getElementById("contadorFilas");
        if (!input || !tabla) return;
        input.addEventListener("input", function () {
            const texto = this.value.toLowerCase().trim();
            let visibles = 0;
            tabla.querySelectorAll("tr").forEach(fila => {
                const coincide = fila.textContent.toLowerCase().includes(texto);
                fila.style.display = coincide ? "" : "none";
                if (coincide) visibles++;
            });
            if (contador) contador.textContent = visibles;
        });
    });
</script>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lugar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                Habitante
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Fecha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tipo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Lugar)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td>
                @(item.IdHabitantesNavigation?.Nombre ?? "Sin habitante")
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>




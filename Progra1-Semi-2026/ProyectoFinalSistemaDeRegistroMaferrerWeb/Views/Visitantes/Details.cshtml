@model ProyectoFinalSistemaDeRegistroMaferrerWeb.Models.Visitante

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Visitante</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HoraEntrada)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HoraEntrada)

@model IEnumerable<ProyectoFinalSistemaDeRegistroMaferrerWeb.Models.Aportacione>

@{
    ViewData["Title"] = "Aportaciones";
    var lista = Model.ToList();
    var totalRecaudado = lista.Where(a => a.Estado == "Solvente").Sum(a => a.Monto);
    var cantSolventes = lista.Count(a => a.Estado == "Solvente");
    var cantPendientes = lista.Count(a => a.Estado == "Pendiente");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Aportaciones</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-primary shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total Recaudado (Solvente)</h6>
                <h3 class="card-title text-primary fw-bold mb-0">@totalRecaudado.ToString("C2")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Aportaciones Solventes</h6>
                <h3 class="card-title text-success fw-bold mb-0">@cantSolventes</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Aportaciones Pendientes</h6>
                <h3 class="card-title text-warning fw-bold mb-0">@cantPendientes</h3>
            </div>
        </div>
    </div>
</div>

<form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-3 p-3 mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-7">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                <input type="text" id="filtroInteractivo" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Escribe para filtrar al instante o presiona Buscar en la base de datos..." />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill me-1"></i>Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
        <div class="col text-md-end text-muted small">
            Mostrando <strong id="contadorFilas">@Model.Count()</strong> registro(s)
        </div>
    </div>
</form>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("filtroInteractivo");
        const tabla = document.querySelector("table tbody");
        const contador = document.getElementById("contadorFilas");
        if (!input || !tabla) return;
        input.addEventListener("input", function () {
            const texto = this.value.toLowerCase().trim();
            let visibles = 0;
            tabla.querySelectorAll("tr").forEach(fila => {
                const coincide = fila.textContent.toLowerCase().includes(texto);
                fila.style.display = coincide ? "" : "none";
                if (coincide) visibles++;
            });
            if (contador) contador.textContent = visibles;
        });
    });
</script>

<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Fecha</th>
            <th>Concepto</th>
            <th>Monto</th>
            <th>N° Comprobante</th>
            <th>Estado</th>
            <th>Habitante</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in lista) {
        <tr>
            <td>@(item.Fecha?.ToString("dd/MM/yyyy") ?? "-")</td>
            <td>@item.Concepto</td>
            <td>@item.Monto.ToString("C2")</td>
            <td>@(string.IsNullOrWhiteSpace(item.NumComprobante) ? "-" : item.NumComprobante)</td>
            <td>
                @if (item.Estado == "Solvente")
                {
                    <span class="badge bg-success">Solvente</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">@item.Estado</span>
                }
            </td>
            <td>@(item.IdHabitantesNavigation?.Nombre ?? "Sin habitante")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.IdAportacion">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdAportacion">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.IdAportacion">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>

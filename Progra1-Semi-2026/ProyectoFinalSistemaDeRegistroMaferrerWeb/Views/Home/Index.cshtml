@{
    ViewData["Title"] = "Inicio";
}

<div class="py-4">
    <h1 class="display-6 fw-bold mb-2">Sistema de Registro — Colonia Alberto Maferrer</h1>
    <p class="text-muted mb-4">Selecciona un módulo para gestionar la información de la colonia.</p>

    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Habitantes</h5>
                    <p class="card-text text-muted small flex-grow-1">Registro y control de residentes, códigos, direcciones y teléfonos.</p>
                    <a asp-controller="Habitantes" asp-action="Index" class="btn btn-primary btn-sm mt-2">Ir a Habitantes</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Aportaciones</h5>
                    <p class="card-text text-muted small flex-grow-1">Control de cuotas, pagos realizados, comprobantes y saldos pendientes.</p>
                    <a asp-controller="Aportaciones" asp-action="Index" class="btn btn-primary btn-sm mt-2">Ir a Aportaciones</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Incidentes</h5>
                    <p class="card-text text-muted small flex-grow-1">Seguimiento de reportes, novedades y estado de atención en la colonia.</p>
                    <a asp-controller="Incidentes" asp-action="Index" class="btn btn-primary btn-sm mt-2">Ir a Incidentes</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Visitantes</h5>
                    <p class="card-text text-muted small flex-grow-1">Control de entradas, salidas, motivos de visita y casas destino.</p>
                    <a asp-controller="Visitantes" asp-action="Index" class="btn btn-primary btn-sm mt-2">Ir a Visitantes</a>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Panel Principal";
    decimal recaudadoMes = ViewBag.RecaudadoMes ?? 0m;
}

<div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="badge bg-info text-dark fw-semibold mb-2 px-3 py-1 rounded-pill">Panel Administrativo</span>
            <h1 class="display-6 fw-bold mb-1">Colonia Alberto Maferrer</h1>
            <p class="mb-0 text-white-50">Control integral de residentes, aportaciones, seguridad e ingresos de visitantes.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Reportes" asp-action="Index" class="btn btn-light fw-semibold rounded-pill px-4">
                <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i>Ver Reportes
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-4 fs-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Habitantes Registrados</div>
                    <div class="fs-3 fw-bold text-dark">@ViewBag.TotalHabitantes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-4 fs-3">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Recaudado este Mes</div>
                    <div class="fs-3 fw-bold text-success">@recaudadoMes.ToString("C2")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-4 fs-3">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Incidentes Pendientes</div>
                    <div class="fs-3 fw-bold text-dark">@ViewBag.IncidentesAbiertos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-4 fs-3">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Visitas en Curso</div>
                    <div class="fs-3 fw-bold text-dark">@ViewBag.VisitasActivas <span class="fs-6 text-muted fw-normal">/ @ViewBag.TotalVisitas</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold text-dark mb-3">Módulos del Sistema</h5>
<div class="row g-3">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 card-hover">
            <div class="card-body d-flex flex-column p-4">
                <div class="text-primary fs-2 mb-2"><i class="bi bi-house-door-fill"></i></div>
                <h5 class="card-title fw-bold">Habitantes</h5>
                <p class="card-text text-muted small flex-grow-1">Padrón de residentes, códigos de vivienda, direcciones y teléfonos.</p>
                <a asp-controller="Habitantes" asp-action="Index" class="btn btn-primary rounded-pill w-100 mt-2">Administrar <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 card-hover">
            <div class="card-body d-flex flex-column p-4">
                <div class="text-success fs-2 mb-2"><i class="bi bi-wallet2"></i></div>
                <h5 class="card-title fw-bold">Aportaciones</h5>
                <p class="card-text text-muted small flex-grow-1">Control de cuotas mensuales, comprobantes de pago y estados solventes.</p>
                <a asp-controller="Aportaciones" asp-action="Index" class="btn btn-success rounded-pill w-100 mt-2">Administrar <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 card-hover">
            <div class="card-body d-flex flex-column p-4">
                <div class="text-warning fs-2 mb-2"><i class="bi bi-shield-exclamation"></i></div>
                <h5 class="card-title fw-bold">Incidentes</h5>
                <p class="card-text text-muted small flex-grow-1">Bitácora de novedades, reportes de seguridad y seguimiento de casos.</p>
                <a asp-controller="Incidentes" asp-action="Index" class="btn btn-warning text-dark fw-semibold rounded-pill w-100 mt-2">Administrar <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 card-hover">
            <div class="card-body d-flex flex-column p-4">
                <div class="text-info fs-2 mb-2"><i class="bi bi-person-vcard-fill"></i></div>
                <h5 class="card-title fw-bold">Visitantes</h5>
                <p class="card-text text-muted small flex-grow-1">Registro de accesos, horas de entrada y salida, motivos y casas destino.</p>
                <a asp-controller="Visitantes" asp-action="Index" class="btn btn-info text-dark fw-semibold rounded-pill w-100 mt-2">Administrar <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

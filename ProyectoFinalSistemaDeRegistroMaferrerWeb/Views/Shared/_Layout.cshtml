<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Colonia Alberto Maferrer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://jsdelivr.net">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="font-family: 'Inter', sans-serif; background-color: #f1f5f9;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background: linear-gradient(90deg, #0f172a 0%, #1e3a8a 100%);">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="bg-primary bg-opacity-25 p-2 rounded-3 d-inline-flex"><i class="bi bi-buildings-fill text-info"></i></span>
                    <span>Colonia Alberto Maferrer</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 text-white" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 text-white" asp-controller="Habitantes" asp-action="Index"><i class="bi bi-people-fill me-1"></i>Habitantes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 text-white" asp-controller="Aportaciones" asp-action="Index"><i class="bi bi-cash-coin me-1"></i>Aportaciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 text-white" asp-controller="Incidentes" asp-action="Index"><i class="bi bi-exclamation-triangle-fill me-1"></i>Incidentes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 text-white" asp-controller="Visitantes" asp-action="Index"><i class="bi bi-person-badge-fill me-1"></i>Visitantes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-2 text-white" asp-controller="Reportes" asp-action="Index"><i class="bi bi-file-earmark-bar-graph-fill me-1"></i>Reportes</a>
                        </li>
                    </ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex align-items-center gap-3 text-white mt-2 mt-lg-0">
                            <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-medium">
                                <i class="bi bi-person-circle text-primary me-1"></i>@User.Identity.Name
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i>Salir
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-3 text-muted small mt-auto">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 — Sistema de Gestión Residencial · Colonia Alberto Maferrer</span>
            <span>ASP.NET Core MVC · EF Core · SQL Server</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

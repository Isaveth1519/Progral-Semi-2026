@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Colonia Alberto Maferrer</title>
    <link href="https://googleapis.com" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body class="d-flex align-items-center justify-content-center vh-100" style="font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
    <div class="card border-0 shadow-lg rounded-4" style="width: 100%; max-width: 410px;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-buildings-fill fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1">Colonia Alberto Maferrer</h4>
                <p class="text-muted small mb-0">Sistema de Gestión Residencial</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small rounded-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-1"></i>@ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="mb-3">
                    <label for="usuario" class="form-label small fw-semibold">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                        <input type="text" class="form-control" id="usuario" name="usuario" placeholder="Ingrese su usuario" required autofocus />
                    </div>
                </div>
                <div class="mb-4">
                    <label for="contrasena" class="form-label small fw-semibold">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" class="form-control" id="contrasena" name="contrasena" placeholder="••••••••" required />
                    </div>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold">
                        Ingresar al Sistema <i class="bi bi-arrow-right-short"></i>
                    </button>
                </div>
            </form>

            <form asp-controller="Account" asp-action="Salir" method="post" class="d-grid mt-2">
                <button type="submit" class="btn btn-outline-danger rounded-pill py-2 fw-semibold">
                    <i class="bi bi-power me-1"></i>Salir del Sistema
                </button>
            </form>
        </div>
    </div>
</body>
</html>
